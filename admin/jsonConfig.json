{
  "i18n": true,
  "type": "tabs",
  "items": {
    "devicesTab": {
      "type": "panel",
      "label": "devicesTab",
      "items": {
        "pollInterval": { "type": "number", "label": "pollInterval", "xs": 12, "sm": 6, "md": 4, "lg": 3, "xl": 2, "min": 5, "max": 3600, "default": 30 },
        "devices": {
          "type": "table",
          "label": "devices",
          "xs": 12, "sm": 12, "md": 12, "lg": 12, "xl": 12,
          "items": [
            { "type": "text", "attr": "name", "title": "name", "width": "12%", "filter": true, "sort": true, "default": "" },
            { "type": "select", "attr": "type", "title": "type", "width": "7%", "filter": true, "sort": true, "default": "midea",
              "options": [ { "label": "Midea", "value": "midea" }, { "label": "Tuya", "value": "tuya" } ] },
            { "type": "text", "attr": "id", "title": "id", "width": "12%", "filter": true, "sort": true, "default": "" },
            { "type": "text", "attr": "host", "title": "host", "width": "10%", "filter": true, "sort": true, "default": "" },
            { "type": "number", "attr": "port", "title": "port", "width": "7%", "min": 1, "max": 65535, "filter": true, "sort": true, "default": 6444 },
            { "type": "password", "attr": "token", "title": "token", "width": "12%", "default": "" },
            { "type": "password", "attr": "key", "title": "key", "width": "12%", "default": "" },
            { "type": "password", "attr": "localKey", "title": "localKey", "width": "10%", "default": "" },
            { "type": "select", "attr": "seasonMode", "title": "seasonMode", "width": "8%", "default": "auto",
              "options": [ { "label": "Auto", "value": "auto" }, { "label": "Summer", "value": "summer" }, { "label": "Winter", "value": "winter" } ] },
            { "type": "text", "attr": "version", "title": "version", "width": "5%", "default": "" }
          ]
        }
      }
    },
    "thermostatTab": {
      "type": "panel",
      "label": "tabControl",
      "items": {
        "thermostatHint1": {
          "type": "staticText",
          "text": "thermostatHint1",
          "xs": 12, "sm": 12, "md": 12, "lg": 12, "xl": 12
        },
        "summerMonths": {
          "type": "text",
          "label": "summerMonths",
          "xs": 12, "sm": 6, "md": 4, "lg": 3, "xl": 2,
          "default": "5,6,7,8,9"
        },
        "globalThermostatActive": {
          "type": "checkbox",
          "label": "globalThermostatActive",
          "xs": 12, "sm": 6, "md": 4, "lg": 3, "xl": 2,
          "default": false
        },
        "thermostatHint2": {
          "type": "staticText",
          "text": "thermostatHint2",
          "xs": 12, "sm": 12, "md": 12, "lg": 12, "xl": 12
        },
        "globalOverrideActive": {
          "type": "checkbox",
          "label": "globalOverrideActive",
          "xs": 12, "sm": 6, "md": 4, "lg": 3, "xl": 2,
          "default": false
        },
        "defaultOverrideMinutes": {
          "type": "number",
          "label": "defaultOverrideMinutes",
          "xs": 12, "sm": 6, "md": 4, "lg": 3, "xl": 2,
          "min": 1, "max": 1440, "step": 1, "default": 60
        },
        "defaultOverrideMode": {
          "type": "select",
          "label": "defaultOverrideMode",
          "xs": 12, "sm": 6, "md": 4, "lg": 3, "xl": 2,
          "default": "auto",
          "options": [
            { "label": "Auto", "value": "auto" },
            { "label": "Cool", "value": "cool" },
            { "label": "Heat", "value": "heat" },
            { "label": "Dry", "value": "dry" },
            { "label": "Fan", "value": "fan" }
          ]
        },
        "defaultOverrideTarget": {
          "type": "number",
          "label": "defaultOverrideTarget",
          "xs": 12, "sm": 6, "md": 4, "lg": 3, "xl": 2,
          "min": 16, "max": 31, "step": 0.5, "default": 22
        },
        "thermostatHint3": {
          "type": "staticText",
          "text": "thermostatHint3",
          "xs": 12, "sm": 12, "md": 12, "lg": 12, "xl": 12
        }
      }
    },
    "scheduleTab": {
      "type": "panel",
      "label": "tabSchedule",
      "items": {
        "scheduleHint1": { "type": "staticText", "text": "scheduleHint1", "xs": 12, "sm": 12, "md": 12, "lg": 12, "xl": 12 },
        "schedules": {
          "type": "table", "label": "schedules", "xs": 12, "sm": 12, "md": 12, "lg": 12, "xl": 12,
          "items": [
            { "type": "select", "attr": "deviceName", "title": "scheduleDeviceName", "width": "9%", "default": "", "noTranslation": true,
              "options": [
                { "label": "KLIM Joerg", "value": "KLIM Joerg" },
                { "label": "KLIM Buero Keller", "value": "KLIM Buero Keller" },
                { "label": "KLI Schlaf Sabrina", "value": "KLI Schlaf Sabrina" },
                { "label": "KLIM Wohn Sabrina", "value": "KLIM Wohn Sabrina" },
                { "label": "KLIMA Wohnzimmer SJ", "value": "KLIMA Wohnzimmer SJ" },
                { "label": "Schlafzimmer Klima Steffi EG", "value": "Schlafzimmer Klima Steffi EG" }
              ]
            },
            { "type": "text", "attr": "name", "title": "scheduleName", "width": "14%", "filter": true, "sort": true, "default": "" },
            { "type": "objectId", "attr": "temperatureSensor", "title": "scheduleTemperatureSensor", "width": "10%", "types": ["state"], "default": "", "noTranslation": true },
            { "type": "objectId", "attr": "presenceSensor", "title": "schedulePresenceSensor", "width": "10%", "types": ["state"], "default": "", "noTranslation": true },
            { "type": "checkbox", "attr": "active", "title": "scheduleActive", "width": "5%", "default": false },
            { "type": "checkbox", "attr": "mo", "title": "mo", "width": "2%", "default": true },
            { "type": "checkbox", "attr": "tu", "title": "tu", "width": "2%", "default": true },
            { "type": "checkbox", "attr": "we", "title": "we", "width": "2%", "default": true },
            { "type": "checkbox", "attr": "th", "title": "th", "width": "2%", "default": true },
            { "type": "checkbox", "attr": "fr", "title": "fr", "width": "2%", "default": true },
            { "type": "checkbox", "attr": "sa", "title": "sa", "width": "2%", "default": true },
            { "type": "checkbox", "attr": "su", "title": "su", "width": "2%", "default": true },
            { "type": "text", "attr": "start", "title": "startTime", "width": "10%", "default": "06:00" },
            { "type": "text", "attr": "end", "title": "endTime", "width": "10%", "default": "22:00" },
            { "type": "select", "attr": "mode", "title": "mode", "width": "8%", "default": "auto",
              "options": [ { "label": "Auto", "value": "auto" }, { "label": "Cool", "value": "cool" }, { "label": "Heat", "value": "heat" }, { "label": "Dry", "value": "dry" }, { "label": "Fan", "value": "fan" } ] },
            { "type": "number", "attr": "target", "title": "targetTemp", "width": "7%", "min": 16, "max": 31, "step": 0.5, "default": 22 },
            { "type": "select", "attr": "fanSpeed", "title": "fanSpeed", "width": "9%", "default": "auto",
              "options": [ { "label": "Auto", "value": "auto" }, { "label": "Low", "value": "low" }, { "label": "Medium", "value": "medium" }, { "label": "High", "value": "high" } ] },
            { "type": "select", "attr": "swing", "title": "swing", "width": "9%", "default": "off",
              "options": [ { "label": "Off", "value": "off" }, { "label": "Vertical", "value": "vertical" }, { "label": "Horizontal", "value": "horizontal" }, { "label": "Both", "value": "both" } ] }
          ]
        }
      }
    }
  }
}
