{
  "i18n": true,
  "type": "tabs",
  "items": {
    "devicesTab": {
      "type": "panel",
      "label": "devicesTab",
      "items": {
        "pollInterval": { "type": "number", "label": "pollInterval", "xs": 12, "sm": 6, "md": 4, "lg": 3, "xl": 2, "min": 5, "max": 3600, "default": 30 },
        "devices": {
          "type": "table",
          "label": "devices",
          "xs": 12, "sm": 12, "md": 12, "lg": 12, "xl": 12,
          "items": [
            { "type": "text", "attr": "name", "title": "name", "width": "12%", "filter": true, "sort": true, "default": "" },
            { "type": "select", "attr": "type", "title": "type", "width": "7%", "filter": true, "sort": true, "default": "midea",
              "options": [ { "label": "Midea", "value": "midea" }, { "label": "Tuya", "value": "tuya" } ] },
            { "type": "text", "attr": "id", "title": "id", "width": "12%", "filter": true, "sort": true, "default": "" },
            { "type": "text", "attr": "host", "title": "host", "width": "10%", "filter": true, "sort": true, "default": "" },
            { "type": "number", "attr": "port", "title": "port", "width": "7%", "min": 1, "max": 65535, "filter": true, "sort": true, "default": 6444 },
            { "type": "password", "attr": "token", "title": "token", "width": "12%", "default": "" },
            { "type": "password", "attr": "key", "title": "key", "width": "12%", "default": "" },
            { "type": "password", "attr": "localKey", "title": "localKey", "width": "12%", "default": "" },
            { "type": "text", "attr": "version", "title": "version", "width": "5%", "default": "" },
            { "type": "checkbox", "attr": "controlActive", "title": "controlActive", "width": "5%", "default": false },
            { "type": "number", "attr": "controlTarget", "title": "controlTarget", "width": "5%", "min": 16, "max": 31, "step": 0.5, "default": 22 },
            { "type": "number", "attr": "controlHysteresis", "title": "controlHysteresis", "width": "6%", "min": 0, "max": 5, "step": 0.1, "default": 0.5 },
            { "type": "text", "attr": "controlSensor", "title": "controlSensor", "width": "10%", "default": "" },
            { "type": "checkbox", "attr": "override", "title": "override", "width": "5%", "default": false },
            { "type": "select", "attr": "overrideMode", "title": "overrideMode", "width": "6%", "default": "auto",
              "options": [ { "label": "Auto", "value": "auto" }, { "label": "Cool", "value": "cool" }, { "label": "Heat", "value": "heat" }, { "label": "Dry", "value": "dry" }, { "label": "Fan", "value": "fan" } ] },
            { "type": "number", "attr": "overrideTarget", "title": "overrideTarget", "width": "6%", "min": 16, "max": 31, "step": 0.5, "default": 22 },
            { "type": "number", "attr": "overrideMinutes", "title": "overrideMinutes", "width": "6%", "min": 1, "max": 1440, "step": 1, "default": 60 }
          ]
        }
      }
    },
    "thermostatTab": {
      "type": "panel",
      "label": "tabControl",
      "items": {
        "thermostatHint1": {
          "type": "staticText",
          "text": "thermostatHint1",
          "xs": 12, "sm": 12, "md": 12, "lg": 12, "xl": 12
        },
        "globalThermostatActive": {
          "type": "checkbox",
          "label": "globalThermostatActive",
          "xs": 12, "sm": 6, "md": 4, "lg": 3, "xl": 2,
          "default": false
        },
        "thermostatHint2": {
          "type": "staticText",
          "text": "thermostatHint2",
          "xs": 12, "sm": 12, "md": 12, "lg": 12, "xl": 12
        },
        "globalOverrideActive": {
          "type": "checkbox",
          "label": "globalOverrideActive",
          "xs": 12, "sm": 6, "md": 4, "lg": 3, "xl": 2,
          "default": false
        },
        "defaultOverrideMinutes": {
          "type": "number",
          "label": "defaultOverrideMinutes",
          "xs": 12, "sm": 6, "md": 4, "lg": 3, "xl": 2,
          "min": 1, "max": 1440, "step": 1, "default": 60
        },
        "defaultOverrideMode": {
          "type": "select",
          "label": "defaultOverrideMode",
          "xs": 12, "sm": 6, "md": 4, "lg": 3, "xl": 2,
          "default": "auto",
          "options": [
            { "label": "Auto", "value": "auto" },
            { "label": "Cool", "value": "cool" },
            { "label": "Heat", "value": "heat" },
            { "label": "Dry", "value": "dry" },
            { "label": "Fan", "value": "fan" }
          ]
        },
        "defaultOverrideTarget": {
          "type": "number",
          "label": "defaultOverrideTarget",
          "xs": 12, "sm": 6, "md": 4, "lg": 3, "xl": 2,
          "min": 16, "max": 31, "step": 0.5, "default": 22
        },
        "thermostatHint3": {
          "type": "staticText",
          "text": "thermostatHint3",
          "xs": 12, "sm": 12, "md": 12, "lg": 12, "xl": 12
        }
      }
    }
  }
}
