{
  "i18n": true,
  "type": "tabs",
  "items": {
    "devicesTab": {
      "type": "panel",
      "label": "devicesTab",
      "items": {
        "pollInterval": { "type": "number", "label": "pollInterval", "xs": 12, "sm": 6, "md": 4, "lg": 3, "xl": 2, "min": 5, "max": 3600, "default": 30 },
        "devices": {
          "type": "table",
          "label": "devices",
          "xs": 12, "sm": 12, "md": 12, "lg": 12, "xl": 12,
          "items": [
            { "type": "text", "attr": "name", "title": "name", "width": "12%", "filter": true, "sort": true, "default": "" },
            { "type": "select", "attr": "type", "title": "type", "width": "7%", "filter": true, "sort": true, "default": "midea",
              "options": [ { "label": "Midea", "value": "midea" }, { "label": "Tuya", "value": "tuya" } ] },
            { "type": "text", "attr": "id", "title": "id", "width": "12%", "filter": true, "sort": true, "default": "" },
            { "type": "text", "attr": "host", "title": "host", "width": "10%", "filter": true, "sort": true, "default": "" },
            { "type": "number", "attr": "port", "title": "port", "width": "7%", "min": 1, "max": 65535, "filter": true, "sort": true, "default": 6444 },
            { "type": "password", "attr": "token", "title": "token", "width": "12%", "default": "" },
            { "type": "password", "attr": "key", "title": "key", "width": "12%", "default": "" },
            { "type": "password", "attr": "localKey", "title": "localKey", "width": "12%", "default": "" },
            { "type": "text", "attr": "version", "title": "version", "width": "7%", "default": "" },
            { "type": "checkbox", "attr": "controlActive", "title": "controlActive", "width": "6%", "default": false },
            { "type": "number", "attr": "controlTarget", "title": "controlTarget", "width": "6%", "min": 16, "max": 31, "step": 0.5, "default": 22 },
            { "type": "number", "attr": "controlHysteresis", "title": "controlHysteresis", "width": "7%", "min": 0, "max": 5, "step": 0.1, "default": 0.5 }
          ]
        }
      }
    },
    "thermostatTab": {
      "type": "panel",
      "label": "tabControl",
      "items": {
        "thermostatHint": {
          "type": "staticText",
          "text": "thermostatHint",
          "xs": 12, "sm": 12, "md": 12, "lg": 12, "xl": 12
        }
      }
    }
  }
}
